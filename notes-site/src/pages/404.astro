---
// notes-site/src/pages/404.astro — the private site's not-found page.
//
// Same shape and the same reason as the public site's: Starlight's injected
// /404 route is disabled in notes-site/astro.config.mjs, and this file is the
// single owner. Every link here is /notes-rooted on purpose — this site is
// mounted at /notes, so a link to "/" would leave the notes area for the
// public site, which a reader who lost a private page does not want.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

Astro.response.headers.set('X-Robots-Tag', 'noindex');
---

<StarlightPage frontmatter={{ title: 'Note not found' }}>
  <p>
    That URL does not exist in anywaye's private notes. If you followed a link
    from an authenticated page and landed here, that is a bug worth reporting
    to the operator who linked it.
  </p>
  <p>The notes are organized as:</p>
  <ul>
    <li><a href="/notes/">Notes home</a> — the whole register.</li>
    <li><a href="/notes/decisions/">Decisions</a> — the decision register.</li>
    <li><a href="/notes/ops/">Operations</a> — how anywaye is run.</li>
    <li><a href="/notes/debt/">Debt</a> — every known gap, owned.</li>
    <li><a href="/notes/projects/">Projects</a> — private notes about public repositories.</li>
  </ul>
  <p>
    The public documentation is at <a href="/">docs.anywaye.com</a>.
  </p>
</StarlightPage>
