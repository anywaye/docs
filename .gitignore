# dependencies
node_modules/

# astro build output — the deploy artifact, never committed
dist/
.astro/

# astro preview / dev caches
.output/

# cafe dev — the compose file it generates from cafaye.yml, never committed.
# Its own first lines say every run rewrites it, so it is build output shaped
# like a source file: one `git add -A` from a commit, and from there a merge
# conflict nobody can resolve by reading it, because both sides are generated.
# `cafe dev --dry-run` refuses here today (no Dockerfile for it to build), which
# is the argument for the entry now rather than after the first accidental
# commit.
/caf.dev.compose.yaml

# local environment overrides (nothing secret is expected here, but never commit one)
.env
.env.*
!.env.example

# os
.DS_Store

# editors
.idea/
.vscode/
*.swp
# materialized by bin/sync-content — never authored here. The public site's
# projects/ subtree is copied from each fleet repository's docs/, and the
# notes site's content tree is copied from cafaye/notes and each private
# repository's notes/. Committing build output shaped like source would freeze
# the site at one sync and make the next merge conflict unreadable.
/src/content/docs/projects/
/notes-site/src/content/docs/

# the record of the last sync — what each tree holds and what was derived.
# Derived by the build, so gitignore says nothing about it; tests read it.
/.sync/

# the cached deploy key provision reads from the operator host alias
.ci-deploy-key
keyring/
secrets/
