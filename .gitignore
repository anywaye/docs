# dependencies
node_modules/

# astro build output — the deploy artifact, never committed
dist/
.astro/

# astro preview / dev caches
.output/

# caf dev — the compose file it generates from cafaye.yml, never committed.
# Its own first lines say every run rewrites it, so it is build output shaped
# like a source file: one `git add -A` from a commit, and from there a merge
# conflict nobody can resolve by reading it, because both sides are generated.
# `caf dev --dry-run` refuses here today (no Dockerfile for it to build), which
# is the argument for the entry now rather than after the first accidental
# commit.
/caf.dev.compose.yaml

# local environment overrides (nothing secret is expected here, but never commit one)
.env
.env.*
!.env.example

# os
.DS_Store

# editors
.idea/
.vscode/
*.swp