#!/usr/bin/env bash

set -euo pipefail

FAST=0
CONTRACTS=0
for arg in "$@"; do
  case "$arg" in
    --fast) FAST=1 ;;
    --contracts) CONTRACTS=1 ;;
    -h | --help)
      sed -n '2,10p' "$0"
      exit 0
      ;;
    *)
      echo "bin/prime: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "bin/prime: $1 not found on PATH — run 'mise install' in this worktree" >&2
    exit 127
  fi
}

step() {
  printf '\n== %s\n' "$1"
}

version_of() {
  "$@" --version 2>/dev/null | head -n 1 || true
}

require node
require npm

step "npm ci"
npm ci

if [ "$FAST" -eq 1 ]; then
  step "skipping build and tests (--fast)"
  exit 0
fi

step "npm run build"
npm run build

step "npm test"
npm test

if [ "$CONTRACTS" -eq 1 ]; then
  step "npm run test:contracts (needs CORE_PATH and a cafe binary)"
  npm run test:contracts
else
  step "skipping the contract tier (--contracts); it did NOT run"
  echo "   Every claim about a shipped contract is UNCHECKED in this run."
  echo "   Run 'bin/prime --contracts', or 'mise run prime:contracts'."
fi

if [ -f /data/workspace/platform/scripts/commentlint.py ]; then
  python3 /data/workspace/platform/scripts/commentlint.py . || exit 1
fi

version="$(version_of node)"
step "prime ok (node ${version:-unknown})"